import pandas as pd
import random


rows = []

for i in range(10000):

    cpu_load = random.randint(20, 95)
    queue_size = random.randint(50, 5000)
    network_load = random.randint(1000, 50000)
    threads = random.choice([4, 8, 16])

    latency = (
        50000
        + cpu_load * 2000
        + queue_size * 50
        + network_load * 2
        + threads * 1000
        + random.randint(-10000, 10000)
    )

    rows.append([
        i,
        cpu_load,
        queue_size,
        network_load,
        threads,
        latency
    ])


df = pd.DataFrame(
    rows,
    columns=[
        "order_id",
        "cpu_load",
        "queue_size",
        "network_load",
        "threads",
        "latency_ns"
    ]
)


