        f"{r['engine']:<10}"
        f"{r['events_processed']:<15}"
        f"{r['total_time_ns']:<15}"
        f"{r['events_per_second']:<15}"
    )

cpp = next(r for r in results if r["engine"] == "C++")
rust = next(r for r in results if r["engine"] == "Rust")

cpp_eps = int(cpp["events_per_second"])
rust_eps = int(rust["events_per_second"])

print("\nPerformance Comparison")
print("-" * 60)

if cpp_eps > rust_eps:
    print(f"C++ is faster by {cpp_eps / rust_eps:.2f}x")
else:
    print(f"Rust is faster by {rust_eps / cpp_eps:.2f}x")


