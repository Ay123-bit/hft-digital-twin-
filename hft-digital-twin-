#include <iostream>
#include <chrono>
#include <vector>
#include <fstream>

using namespace std;
using namespace chrono;


struct MarketEvent {
    long long order_id;
    double price;
    int quantity;
};


int main() {

    const int EVENTS = 1000000;


    // Pre-allocate memory
    vector<MarketEvent> events(EVENTS);


    auto start = high_resolution_clock::now();


    // Direct indexed write - avoids push_back overhead
    for (int i = 0; i < EVENTS; i++) {

        events[i].order_id = i;
        events[i].price = 180.50;
        events[i].quantity = 100;
    }


    auto end = high_resolution_clock::now();


    auto duration =
        duration_cast<nanoseconds>(
            end - start
        ).count();


    long long events_per_second =
        EVENTS * 1000000000LL / duration;


    cout << "C++ HFT Engine Benchmark" << endl;
    cout << "------------------------" << endl;

    cout << "Events processed: "
         << EVENTS
         << endl;


    cout << "Total time: "
         << duration
         << " ns"
         << endl;


    cout << "Events/sec: "
         << events_per_second
         << endl;



    // Save benchmark result
    ofstream file("../benchmarks/cpp_results.csv");


    file << "engine,events_processed,total_time_ns,events_per_second\n";


    file << "C++,"
         << EVENTS
         << ","
         << duration
         << ","
         << events_per_second
         << "\n";


    file.close();


    cout << "\nBenchmark saved: cpp_results.csv"
         << endl;


    return 0;
}



