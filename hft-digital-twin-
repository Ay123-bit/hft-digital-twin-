use std::fs::File;
use std::io::Write;
use std::time::Instant;


struct MarketEvent {
    order_id: u64,
    price: f64,
    quantity: i32,
}


fn main() {

    const EVENTS: usize = 1_000_000;


    let mut events: Vec<MarketEvent> =
        Vec::with_capacity(EVENTS);


    let start = Instant::now();


    for i in 0..EVENTS {

        events.push(
            MarketEvent {
                order_id: i as u64,
                price: 180.50,
                quantity: 100,
            }
        );
    }


    let duration =
        start.elapsed().as_nanos();


    let events_per_second =
        (EVENTS as u128 * 1_000_000_000)
        / duration;


    println!("Rust HFT Engine Benchmark");
    println!("-------------------------");

    println!(
        "Events processed: {}",
        EVENTS
    );


    println!(
        "Total time: {} ns",
        duration
    );


    println!(
        "Events/sec: {}",
        events_per_second
    );


    let mut file =
        File::create("../benchmarks/rust_results.csv")
        .unwrap();


    writeln!(
        file,
        "engine,events_processed,total_time_ns,events_per_second"
    ).unwrap();


    writeln!(
        file,
        "Rust,{},{},{}",
        EVENTS,
        duration,
        events_per_second
    ).unwrap();


    println!(
        "\nBenchmark saved: rust_results.csv"
    );
}


